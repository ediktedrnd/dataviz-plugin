# Dataviz MCP server — env reference for both transports.
#
# Where this file gets read:
#   - HTTP mode (docker compose up):
#       compose.yml at repo root reads /<repo>/.env (gitignored).
#       Copy this file there: cp mcp-server/.env.example .env
#   - Stdio mode (local Claude Code, `node mcp-server/index.js`):
#       dotenv reads /<repo>/mcp-server/.env or /<repo>/mcp-server/.env.local.
#       Either copy this file alongside, or use ~/.config/dataviz/credentials.json.

# ─────────────────────────────────────────────────────────────────────
# HTTP MODE (remote MCP, OAuth-protected)
# ─────────────────────────────────────────────────────────────────────

# HS256 secret used to sign+verify MCP access tokens. For local test you
# control both ends, so any value works as long as the same string is
# used to mint and verify. In the dev's Dataviz compose, the same value
# is shared between the Dataviz backend and this MCP server.
# In production, Terraform provisions ${env}/dataviz-mcp/oauth in
# Secrets Manager and injects it into both ECS task definitions.
MCP_ACCESS_TOKEN_SECRET=local-test-secret-please-change-me-32chars-or-more

# OAuth identity advertised in /.well-known/oauth-protected-resource and
# required to match the `iss` claim on incoming tokens.
OAUTH_ISSUER=https://dataviz.test.local

# Token audience. Must match the `aud` claim on incoming tokens. Use the
# URL the client will hit (here: the docker-mapped local port).
MCP_RESOURCE=http://localhost:3000/mcp

# Self-URL advertised in metadata responses.
MCP_PUBLIC_URL=http://localhost:3000

# Origin allowlist for browser clients (comma-separated). Empty = allow any.
MCP_ALLOWED_ORIGINS=

# Upstream Dataviz API. Tool calls forward the user's bearer token here.
# - Standalone test (this compose): leave as the public URL; tool calls
#   will 401 against upstream until the dev's feat/mcp-oauth-sso branch
#   is on EC2.
# - Full-stack test via Dataviz/docker-compose.yml: that file overrides
#   this to http://backend:3001 (docker network).
DATAVIZ_URL=https://dataviz.edikted.tech

PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────
# STDIO MODE (local Claude Code; legacy email+password login)
# ─────────────────────────────────────────────────────────────────────
# Only used when running `node mcp-server/index.js` directly (no HTTP
# transport, no OAuth). Prefer ~/.config/dataviz/credentials.json on
# macOS/Linux; env vars take precedence so Cowork can override.
#
# DATAVIZ_EMAIL=your-email@edikted.com
# DATAVIZ_PASSWORD=your-password
