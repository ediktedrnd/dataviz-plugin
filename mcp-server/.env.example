# Dev-only fallback. For production use, run the `dataviz-setup` skill which
# writes to ~/.config/dataviz/credentials.json (preferred, per-user, 0600).
# These env vars are only used if the credentials file is missing.
DATAVIZ_URL=https://dataviz.edikted.tech
DATAVIZ_EMAIL=your-email@edikted.com
DATAVIZ_PASSWORD=your-password
